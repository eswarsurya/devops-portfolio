{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WriteAndReadBackupObjects",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject"],
      "Resource": "arn:aws:s3:::REPLACE_BUCKET_NAME/*"
    },
    {
      "Sid": "ListBucketForRestoreAndVerify",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::REPLACE_BUCKET_NAME"
    }
  ]
}
