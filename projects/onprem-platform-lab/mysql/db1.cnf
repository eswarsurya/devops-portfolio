[mysqld]
server_id                = 1
gtid_mode                = ON
enforce_gtid_consistency = ON
log_bin                  = mysql-bin
log_replica_updates      = ON
binlog_format            = ROW
relay_log                = relay-bin
skip_name_resolve        = ON
# master-master with db2: each primary hands out different ids, so inserts on both never collide
auto_increment_increment = 2
auto_increment_offset    = 1
