[mysqld]
server_id                = 3
gtid_mode                = ON
enforce_gtid_consistency = ON
log_bin                  = mysql-bin
log_replica_updates      = ON
binlog_format            = ROW
relay_log                = relay-bin
skip_name_resolve        = ON
# read replica: super_read_only is switched on by scripts/setup-replication.sh (SET PERSIST)
# after first start, because the image's first-start setup needs to write the root user
