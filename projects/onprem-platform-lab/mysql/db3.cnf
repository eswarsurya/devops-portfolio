[mysqld]
server_id                = 3
gtid_mode                = ON
enforce_gtid_consistency = ON
log_bin                  = mysql-bin
log_replica_updates      = ON
binlog_format            = ROW
relay_log                = relay-bin
skip_name_resolve        = ON
# read replica: only replication can write here
read_only                = ON
super_read_only          = ON
